{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões mínimas da janela principal: os comandos do host, o terminal do projeto e a escuta de eventos do motor.",
  "windows": ["main"],
  "permissions": [
    "allow-engine-request",
    "allow-pick-project-folder",
    "allow-engine-status",
    "allow-restart-engine",
    "allow-list-recent-projects",
    "allow-open-recent-project",
    "allow-diagnostic-log",
    "allow-third-party-notices",
    "allow-terminal-open",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
