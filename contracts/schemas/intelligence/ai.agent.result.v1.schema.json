{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mariliz.dev/schemas/intelligence/ai.agent.result.v1.schema.json",
  "title": "Resultado de um agente",
  "description": "Envelope comum a todos os agentes; output tem schema próprio por agente. evidence só aceita chunkId recuperado nesta execução (conferido em código, não pelo schema).",
  "type": "object",
  "required": ["schema", "agentId", "agentVersion", "executionId", "status", "startedAt", "completedAt", "inputDigest", "output", "evidence", "warnings", "errors", "nextActions", "approvalRequired", "usage"],
  "properties": {
    "schema": { "const": "ai.agent.result.v1" },
    "agentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "agentVersion": { "type": "string", "pattern": "^[0-9]+$" },
    "executionId": { "type": "string", "pattern": "^ex-[0-9a-f]{12}$" },
    "status": { "enum": ["completed", "failed", "skipped"] },
    "startedAt": { "type": "string", "minLength": 20 },
    "completedAt": { "type": "string", "minLength": 20 },
    "inputDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "output": {
      "type": "object",
      "required": ["schema"],
      "properties": { "schema": { "type": "string", "pattern": "^[a-z]+([.][a-z]+)*[.]v[0-9]+$" } }
    },
    "evidence": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "nextActions": {
      "description": "Mesmo formato de ai.ack.v2#/$defs/action.",
      "type": "array",
      "maxItems": 32,
      "items": { "type": "object", "required": ["id", "kind", "summary", "requiresApproval"] }
    },
    "approvalRequired": { "type": "boolean" },
    "usage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "properties": { "errors": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "notice": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "maxLength": 300 }
      },
      "additionalProperties": false
    }
  }
}
