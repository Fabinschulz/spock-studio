{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mariliz.dev/schemas/intelligence/ai.ack.v2.schema.json",
  "title": "Inteligência → motor: fim de uma etapa do workflow (última linha do NDJSON)",
  "description": "nextActions são propostas. O motor aplica a política e decide se a ação precisa de aprovação, mesmo que requiresApproval venha falso. O texto livre do pedido não volta aqui.",
  "type": "object",
  "required": ["schema", "workflowId", "workflowVersion", "runId", "executionId", "projectId", "status", "startedAt", "completedAt", "warnings", "errors", "output", "agents", "usage", "nextActions"],
  "properties": {
    "schema": { "const": "ai.ack.v2" },
    "workflowId": { "type": "string", "pattern": "^[a-z]+([.][a-z]+)*$" },
    "workflowVersion": { "type": "string", "pattern": "^[0-9]+$" },
    "runId": { "type": "string", "pattern": "^run-[0-9a-f]{12}$" },
    "executionId": { "type": "string", "pattern": "^ex-[0-9a-f]{12}$" },
    "projectId": { "type": "string", "pattern": "^p-[0-9a-f]{12}$" },
    "status": { "enum": ["completed", "interrupted", "failed"] },
    "startedAt": { "type": "string", "minLength": 20 },
    "completedAt": { "type": "string", "minLength": 20 },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "output": {
      "type": "object",
      "required": ["summary", "plan", "stacks", "evidence", "retrievalAttempted"],
      "properties": {
        "summary": { "type": "string", "maxLength": 2000 },
        "plan": {
          "description": "engineering.plan.v1 (contracts/schemas/intelligence/engineering.plan.v1.schema.json).",
          "type": "object",
          "required": ["schema", "steps"],
          "properties": { "schema": { "const": "engineering.plan.v1" } }
        },
        "stacks": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "retrievalAttempted": { "type": "boolean" },
        "impact": {
          "description": "engineering.impact.v1 (contracts/schemas/intelligence/engineering.impact.v1.schema.json).",
          "type": "object",
          "required": ["schema"],
          "properties": { "schema": { "const": "engineering.impact.v1" } }
        },
        "evaluation": {
          "description": "O veredito é sempre determinístico; o juiz por modelo só registra uma opinião.",
          "type": "object",
          "required": ["schema", "verdict", "judge", "tokens"],
          "properties": {
            "schema": { "const": "engineering.evaluation.v1" },
            "verdict": { "const": "deterministic" },
            "judge": { "enum": ["not_run", "passed", "failed"] },
            "tokens": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agentId", "agentVersion", "status", "durationMs", "tokens"],
        "properties": {
          "agentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "agentVersion": { "type": "string", "pattern": "^[0-9]+$" },
          "status": { "enum": ["completed", "failed", "skipped"] },
          "durationMs": { "type": "integer", "minimum": 0 },
          "tokens": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "object",
      "required": ["modelCalls", "inputTokens", "outputTokens", "costUsd"],
      "properties": {
        "modelCalls": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "nextActions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/action" } },
    "approval": {
      "type": "object",
      "required": ["interruptId", "actionIds"],
      "properties": {
        "interruptId": { "type": "string", "pattern": "^int-[0-9a-f]{12}$" },
        "actionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^act-[0-9a-z-]{1,32}$" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "interrupted" } } },
      "then": { "required": ["approval"] },
      "else": { "not": { "required": ["approval"] } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "properties": { "errors": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "notice": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "maxLength": 300 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["documentId", "chunkId", "filePath", "hash", "score", "excerpt"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "chunkId": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "score": { "type": "number" },
        "excerpt": { "type": "string", "maxLength": 160 }
      },
      "additionalProperties": false
    },
    "action": {
      "description": "Proposta de efeito. Não carrega comando, executável nem conteúdo a gravar: o motor resolve commandId contra os comandos que ele mesmo descobriu.",
      "type": "object",
      "required": ["id", "kind", "summary", "requiresApproval"],
      "properties": {
        "id": { "type": "string", "pattern": "^act-[0-9a-z-]{1,32}$" },
        "kind": { "enum": ["file.write", "command.run", "dependency.install", "config.change", "migration.run", "external.write"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
        "target": { "type": "string", "minLength": 1, "maxLength": 260 },
        "commandId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "requiresApproval": { "type": "boolean" }
      },
      "additionalProperties": false,
      "if": { "properties": { "kind": { "const": "command.run" } } },
      "then": { "required": ["commandId"] }
    }
  }
}
