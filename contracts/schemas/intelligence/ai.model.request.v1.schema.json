{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mariliz.dev/schemas/intelligence/ai.model.request.v1.schema.json",
  "title": "Inteligência → proxy de modelo do motor",
  "description": "O modelo, o provedor e a chave são escolhidos pelo motor; a requisição não os carrega. O motor recusa o que passar do orçamento da execução.",
  "type": "object",
  "required": ["schema", "executionId", "agentId", "purpose", "messages", "maxTokens"],
  "properties": {
    "schema": { "const": "ai.model.request.v1" },
    "executionId": { "type": "string", "pattern": "^ex-[0-9a-f]{12}$" },
    "agentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "purpose": { "enum": ["classify", "plan", "architecture", "judge", "rewrite-query"] },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "user", "assistant"] },
          "content": { "type": "string", "minLength": 1, "maxLength": 32000 }
        },
        "additionalProperties": false
      }
    },
    "maxTokens": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "responseSchema": { "type": "string", "pattern": "^[a-z]+([.][a-z]+)*[.]v[0-9]+$" }
  },
  "additionalProperties": false
}
