{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mariliz.dev/schemas/intelligence/engineering.plan.v1.schema.json",
  "title": "Plano de execução",
  "description": "Formato que plan_validator já aceita em intelligence/workflows/engineering/graph.py. Chaves de comando, caminho ou escrita são proibidas em qualquer nível (conferido também em código).",
  "type": "object",
  "required": ["schema", "steps"],
  "properties": {
    "schema": { "const": "engineering.plan.v1" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
