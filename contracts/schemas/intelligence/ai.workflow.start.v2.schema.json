{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mariliz.dev/schemas/intelligence/ai.workflow.start.v2.schema.json",
  "title": "Motor → inteligência: iniciar um workflow",
  "description": "O motor já autorizou o projeto e filtrou as fontes. Limites e política vêm do motor; a inteligência só pode ser mais restritiva.",
  "type": "object",
  "required": ["schema", "workflowId", "workflowVersion", "runId", "executionId", "projectId", "input", "context", "limits", "policy"],
  "properties": {
    "schema": { "const": "ai.workflow.start.v2" },
    "workflowId": { "type": "string", "pattern": "^[a-z]+([.][a-z]+)*$" },
    "workflowVersion": { "type": "string", "pattern": "^[0-9]+$" },
    "runId": { "type": "string", "pattern": "^run-[0-9a-f]{12}$" },
    "executionId": { "type": "string", "pattern": "^ex-[0-9a-f]{12}$" },
    "projectId": { "type": "string", "pattern": "^p-[0-9a-f]{12}$" },
    "workspaceId": { "type": "null" },
    "input": {
      "type": "object",
      "required": ["goal"],
      "properties": {
        "goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "impact": { "type": "boolean" },
        "requiresApproval": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["available", "stacks"],
      "properties": {
        "available": { "type": "boolean" },
        "stacks": { "type": "array", "maxItems": 8, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" } },
        "knowledgeRoot": { "type": "string", "minLength": 1 },
        "executionRoot": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "hash"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "text": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "limits": { "$ref": "#/$defs/limits" },
    "policy": {
      "type": "object",
      "required": ["allowedActions", "modelAllowed"],
      "properties": {
        "allowedActions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/actionKind" } },
        "modelAllowed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "broker": { "$ref": "#/$defs/broker" }
  },
  "additionalProperties": false,
  "if": { "properties": { "policy": { "properties": { "modelAllowed": { "const": true } } } } },
  "then": { "required": ["broker"] },
  "else": { "not": { "required": ["broker"] } },
  "$defs": {
    "limits": {
      "type": "object",
      "required": ["maxIterations", "maxMilliseconds", "maxTokens", "maxCostUsd"],
      "properties": {
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxMilliseconds": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "maxTokens": { "type": "integer", "minimum": 0 },
        "maxCostUsd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "broker": {
      "description": "Proxy de modelo do motor. O token vale só para esta execução e não é a chave do provedor.",
      "type": "object",
      "required": ["url", "token"],
      "properties": {
        "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}/v1/model$" },
        "token": { "type": "string", "minLength": 32, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "actionKind": { "enum": ["file.write", "command.run", "dependency.install", "config.change", "migration.run", "external.write"] }
  }
}
