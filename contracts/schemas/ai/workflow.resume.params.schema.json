{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mariliz.dev/schemas/ai/workflow.resume.params.schema.json",
  "description": "approvalId e actionIds são a decisão de quem aprova: o approvalId que veio em approval.required e as ações que aprova. Sem actionIds, nenhuma ação é aprovada. Com ações propostas, o approvalId é obrigatório (conferido pelo motor).",
  "type": "object",
  "required": ["projectId", "runId"],
  "properties": {
    "projectId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "approvalId": { "type": "string", "pattern": "^apr-[0-9a-f]{12}$" },
    "actionIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^act-[0-9a-z-]{1,32}$" }
    }
  },
  "additionalProperties": false
}
