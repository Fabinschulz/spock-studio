{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mariliz.dev/schemas/ai/tool.execution.data.schema.json",
  "description": "Dados de tool.started e tool.completed. Só ferramentas sem efeito rodam na inteligência; efeitos são ações aprovadas e executadas pelo motor.",
  "type": "object",
  "required": ["toolId", "effect", "at"],
  "properties": {
    "toolId": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
    "agentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "effect": { "const": "none" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "at": { "type": "string", "minLength": 20 }
  },
  "additionalProperties": false
}
