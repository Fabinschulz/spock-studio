      "mechanisms": [
        {
          "id": "profile",
          "label": "Perfil do AWS CLI",
          "description": "Um perfil de ~/.aws/config: chaves, IAM Identity Center (SSO), processo externo ou papel assumido. Para SSO, rode antes aws sso login --profile <perfil>.",
          "fields": [
            {
              "name": "profile",
              "label": "Perfil",
              "hint": "Nome do perfil em ~/.aws/config, por exemplo dev.",
              "required": true
            },
            {
              "name": "region",
              "label": "Região padrão",
              "hint": "Por exemplo sa-east-1. As leituras por região usam esta quando o pedido não diz outra.",
              "required": true
            }
          ]
        },
        {
          "id": "default",
          "label": "Cadeia padrão do SDK",
          "description": "Variáveis de ambiente, AWS_PROFILE, perfil default, SSO, web identity ou o papel da máquina, na ordem oficial do AWS SDK.",
          "fields": [
            {
              "name": "region",
              "label": "Região padrão",
              "hint": "Por exemplo sa-east-1. As leituras por região usam esta quando o pedido não diz outra.",
              "required": true
            }
          ]
        },
        {
          "id": "assume-role",
          "label": "Assumir um papel (AssumeRole)",
          "description": "Credenciais temporárias de 15 minutos de um papel IAM, a partir de um perfil ou da cadeia padrão.",
          "fields": [
            {
              "name": "roleArn",
              "label": "Role ARN",
              "hint": "arn:aws:iam::<conta>:role/<nome>.",
              "required": true
            },
            {
              "name": "sourceProfile",
              "label": "Perfil de origem",
              "hint": "Opcional. Sem ele, vale a cadeia padrão.",
              "required": false
            },
            {
              "name": "region",
              "label": "Região padrão",
              "hint": "Por exemplo sa-east-1. As leituras por região usam esta quando o pedido não diz outra.",
              "required": true
