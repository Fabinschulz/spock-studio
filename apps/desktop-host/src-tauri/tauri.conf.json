{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mariliz AI Engineering",
  "version": "0.1.0",
  "identifier": "dev.mariliz.ai-engineering",
  "build": {
    "beforeDevCommand": "pnpm --filter @mariliz/desktop-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @mariliz/desktop-ui build",
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mariliz AI Engineering",
        "width": 900,
        "height": 650,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "maximized": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mariliz-engine"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"]
      }
    }
  }
}
