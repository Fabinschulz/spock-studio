<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Mariliz.Application\Mariliz.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI: o cofre das credenciais de integração no Windows. -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="3.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chaves públicas com que a HashiCorp e o OpenTofu assinam as listas de checksums. -->
    <EmbeddedResource Include="Iac\hashicorp-release-key.asc" LogicalName="Mariliz.Infrastructure.Iac.hashicorp-release-key.asc" />
    <EmbeddedResource Include="Iac\opentofu-release-key.asc" LogicalName="Mariliz.Infrastructure.Iac.opentofu-release-key.asc" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mariliz.Application.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
