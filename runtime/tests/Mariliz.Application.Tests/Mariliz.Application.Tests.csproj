<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3: o projeto de teste é um executável. -->
    <OutputType>Exe</OutputType>
    <!-- xUnit1051 (analisador do v3) pede TestContext.Current.CancellationToken em toda chamada com token. Aqui os testes passam
         default de propósito (mapeamento de erro sem cancelamento, esperas curtas); adotar o token é uma mudança à parte. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="JsonSchema.Net" Version="9.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Mariliz.Application\Mariliz.Application.csproj" />
    <ProjectReference Include="..\..\Mariliz.Infrastructure\Mariliz.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Mariliz.Infrastructure.Cloud\Mariliz.Infrastructure.Cloud.csproj" />
    <ProjectReference Include="..\..\Mariliz.Cli\Mariliz.Cli.csproj" />
  </ItemGroup>

</Project>