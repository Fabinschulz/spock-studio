{
  "name": "mariliz-ai-engineering",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "ui:dev": "pnpm --filter @mariliz/desktop-ui dev",
    "ui:build": "pnpm --filter @mariliz/desktop-ui build",
    "ui:test": "pnpm --filter @mariliz/desktop-ui test",
    "ui:typecheck": "pnpm --filter @mariliz/desktop-ui typecheck",
    "ui:lint": "pnpm --filter @mariliz/desktop-ui lint",
    "verify": "python scripts/verify.py",
    "validate:live": "python scripts/live-validation.py"
  }
}
