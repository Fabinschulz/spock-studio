{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mariliz.dev/schemas/harness-proposal.v1.schema.json",
  "title": "Harness proposal v1",
  "description": "Proposal written by the harness-engineer agent to .mariliz/proposal.json. The Mariliz engine validates it, never trusts it, and plans only what a person approves. It cannot carry permissions, hooks, commands or MCP servers.",
  "type": "object",
  "required": ["schema", "origin", "decisions"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "origin": { "const": "harness-engineer" },
    "decisions": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["id", "decision", "justification", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "mariliz.agent.harness-engineer",
              "mariliz.agent.code-reviewer",
              "mariliz.agent.verifier",
              "mariliz.skill.harness-contract",
              "mariliz.rule.general",
              "mariliz.rule.stack-dotnet",
              "mariliz.rule.stack-javascript",
              "mariliz.rule.repo-commands"
            ]
          },
          "decision": { "enum": ["enable", "keep", "skip"] },
          "justification": { "type": "string", "minLength": 10, "maxLength": 600 },
          "evidence": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "maxLength": 300 } }
        }
      }
    },
    "additionalRules": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "content", "justification", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,40}$" },
          "title": { "type": "string", "minLength": 3, "maxLength": 80 },
          "content": { "type": "string", "minLength": 20, "maxLength": 4000 },
          "justification": { "type": "string", "minLength": 10, "maxLength": 600 },
          "evidence": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "maxLength": 300 } }
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["kind", "text", "evidence"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["fact", "inference", "hypothesis", "unverified"] },
          "text": { "type": "string", "minLength": 3, "maxLength": 600 },
          "evidence": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 300 } }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 3, "maxLength": 400 }
    }
  }
}
